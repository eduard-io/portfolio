---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Introduction from '../components/Introduction.astro';
import SelectedProjects from '../components/SelectedProjects.astro';
import Experience from '../components/Experience.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout>
  <SiteHeader />
  <div class="page-content">
    <main id="main">
      <Introduction />
      <div class="remaining-content"><SelectedProjects /><Experience /></div>
    </main>
    <div class="footer-reveal"><SiteFooter /></div>
  </div>
</BaseLayout>

<style>
  .page-content {
    display: flow-root;
  }

  .remaining-content {
    display: grid;
    gap: var(--section-gap);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.intro-animate) .page-content {
      animation: content-move 600ms ease-in-out 1300ms both;
    }

    :global(.intro-animate) .remaining-content > :global(*),
    :global(.intro-animate) .footer-reveal {
      animation: fade-in 450ms ease-out both;
    }

    :global(.intro-animate) .remaining-content > :global(*:nth-child(1)) {
      animation-delay: 1570ms;
    }
    :global(.intro-animate) .remaining-content > :global(*:nth-child(2)) {
      animation-delay: 1660ms;
    }
    :global(.intro-animate) .footer-reveal {
      animation-delay: 1750ms;
    }

    :global(.intro-animate) .remaining-content > :global(*:focus-within),
    :global(.intro-animate) .footer-reveal:focus-within,
    :global(.intro-animate) .page-content:focus-within {
      animation: none;
    }
  }

  @keyframes content-move {
    from {
      transform: translateY(var(--intro-offset));
    }
    to {
      transform: translateY(0);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
